---
/**
 * Planned pricing. Nothing here is purchasable: every price is labelled
 * "planned", and every call-to-action leads to the early-access form.
 */
import { landingAnchors } from '../../config/navigation.ts';
import { landing, type PricingPlan } from '../../config/landing.ts';
import { brandify } from '../../lib/brand.ts';
import { canRegister, site } from '../../lib/catalog.ts';
import { formatMoney } from '../../lib/commerce.ts';
import Badge, { type BadgeTone } from '../ui/Badge.astro';
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  index: string;
}

const { index } = Astro.props;
const { pricing } = landing;
const plans: PricingPlan[] = pricing.plans;
const money = (amount: number) => formatMoney(amount, site.currency, site.locale);

function priceOf(plan: PricingPlan): { amount: string; suffix: string; spoken: string } {
  if (plan.billing === 'free') return { amount: 'Free', suffix: '', spoken: 'Free' };
  const suffix = plan.billing === 'monthly' ? '/ month' : 'one-time';
  const period = plan.billing === 'monthly' ? 'per month' : 'one-time';
  if (plan.priceRange) {
    const [low, high] = plan.priceRange;
    return { amount: `${money(low)}–${money(high)}`, suffix, spoken: `Planned range ${money(low)} to ${money(high)} ${period}` };
  }
  const value = money(plan.price ?? 0);
  return { amount: value, suffix, spoken: `Planned price ${value} ${period}` };
}

const open = canRegister();
const stageOf = (plan: PricingPlan) => (!open && plan.stageWhenClosed ? plan.stageWhenClosed : plan.stage);
const tone = (plan: PricingPlan): BadgeTone => (plan.billing === 'free' ? (open ? 'live' : 'neutral') : plan.highlight ? 'building' : 'neutral');
---

<section id="pricing" class="section scroll-mt-16 border-t border-line" aria-labelledby="pricing-title">
  <div class="container-site">
    <SectionHeading id="pricing-title" index={index} eyebrow={pricing.eyebrow} title={pricing.title} description={pricing.description} class="mb-12" />

    <ul class="grid gap-5 lg:grid-cols-3">
      {
        plans.map((plan, i) => {
          const price = priceOf(plan);
          return (
            <li
              class:list={[
                'reveal relative flex flex-col rounded-[var(--radius-card)] border p-7',
                plan.highlight ? 'border-[color-mix(in_oklch,var(--accent)_55%,transparent)] bg-surface shadow-[var(--shadow-2)]' : 'border-line bg-surface/60',
              ]}
              style={`--i: ${i}`}
              data-plan={plan.id}
            >
              <div class="flex flex-wrap items-start justify-between gap-3">
                <h3 class="text-xl font-[620] tracking-[-0.02em] text-ink">{brandify(plan.name, site.name)}</h3>
                <Badge tone={tone(plan)}>{stageOf(plan)}</Badge>
              </div>
              {plan.billing !== 'free' && <p class="eyebrow mt-6">{plan.priceRange ? 'Planned range' : 'Planned price'}</p>}
              <p class:list={['flex items-baseline gap-2', plan.billing === 'free' ? 'mt-6' : 'mt-2']}>
                <span class="tabular text-[2.25rem] leading-none font-[650] tracking-[-0.03em] text-ink" aria-hidden="true">
                  {price.amount}
                </span>
                {price.suffix && (
                  <span class="text-sm text-ink-3" aria-hidden="true">
                    {price.suffix}
                  </span>
                )}
                <span class="sr-only">{price.spoken}</span>
              </p>
              {plan.founding && (
                <p class="mt-3 rounded-[var(--radius-control)] bg-accent-soft px-3 py-2 text-sm text-ink">
                  <span class="font-semibold">{money(plan.founding.price)}</span> — {plan.founding.label.charAt(0).toLowerCase() + plan.founding.label.slice(1)}
                </p>
              )}
              <p class="mt-5 text-[0.9375rem] text-ink-2">{plan.description}</p>
              <ul class="mt-5 space-y-2.5 text-sm text-ink-2">
                {plan.includes.map((item) => (
                  <li class="flex items-start gap-2.5">
                    <Icon name="check" size={15} class="mt-0.5 text-ok" />
                    {item}
                  </li>
                ))}
              </ul>
              <div class="mt-auto pt-7">
                <a
                  href={landingAnchors.register}
                  class:list={['btn w-full', plan.highlight ? 'btn-primary' : 'btn-secondary']}
                  data-intent-link={plan.cta.intent}
                >
                  <span>{plan.cta.label}</span>
                  <Icon name="arrow-right" size={17} class="btn-arrow" />
                </a>
                <p class="mt-3 text-center text-xs text-ink-3">{plan.billing === 'free' ? 'No cost, no obligation' : 'Not available to buy yet'}</p>
              </div>
            </li>
          );
        })
      }
    </ul>
    <p class="mt-6 flex items-start gap-2 text-sm text-ink-3">
      <Icon name="info" size={15} class="mt-0.5" />
      {pricing.footnote}
    </p>
  </div>
</section>
