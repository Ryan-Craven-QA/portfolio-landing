---
/**
 * Product-line illustrations: small CSS compositions that suggest the kind of
 * work each line handles. Purely decorative — no data, no claims.
 * They animate only while their card is hovered or focused, and never under
 * prefers-reduced-motion.
 */
import type { Line } from '../../lib/catalog.ts';

interface Props {
  art: Line['art'];
  hue: number;
  class?: string;
}

const { art, hue, class: className } = Astro.props;
const days = ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
const marked = new Set([3, 9, 17, 24, 30]);
const due = 19;
---

<div class:list={['line-art relative overflow-hidden', className]} style={`--tone-h: ${hue}`} data-art={art} aria-hidden="true">
  <div class="dot-grid absolute inset-0 opacity-70"></div>
  <div class="glow absolute inset-0"></div>

  {
    art === 'document-fields' && (
      <div class="df">
        <div class="df-doc">
          <span style="--w: 82%" />
          <span style="--w: 64%" />
          <span style="--w: 90%" />
          <span style="--w: 48%" />
          <span style="--w: 76%" />
          <span style="--w: 58%" />
          <i class="df-scan" />
        </div>
        <svg class="df-link" viewBox="0 0 40 60" preserveAspectRatio="none">
          <path d="M0 30 C 20 30, 20 8, 40 8 M0 30 H 40 M0 30 C 20 30, 20 52, 40 52" />
        </svg>
        <div class="df-fields">
          {['Vendor', 'Date', 'Total'].map((label, n) => (
            <div class="df-field" style={`--n: ${n}`}>
              <span class="df-label">{label}</span>
              <span class="df-value" style={`--w: ${[72, 46, 38][n]}%`} />
            </div>
          ))}
        </div>
      </div>
    )
  }

  {
    art === 'plugin-toggles' && (
      <div class="pt">
        {[
          { on: true, w: [58, 36] },
          { on: false, w: [70, 42], flip: true },
          { on: true, w: [50, 30] },
        ].map((row, n) => (
          <div class="pt-row" style={`--n: ${n}`}>
            <span class="pt-icon" />
            <span class="pt-text">
              <span style={`--w: ${row.w[0]}%`} />
              <span style={`--w: ${row.w[1]}%`} />
            </span>
            <span class:list={['pt-toggle', row.on && 'is-on', row.flip && 'flip']} />
          </div>
        ))}
      </div>
    )
  }

  {
    art === 'calendar-grid' && (
      <div class="cg">
        <div class="cg-days">
          {days.map((d) => (
            <span>{d}</span>
          ))}
        </div>
        <div class="cg-grid">
          {Array.from({ length: 35 }, (_, i) => (
            <span class:list={['cg-cell', marked.has(i) && 'mark', i === due && 'due', i > 30 && 'out']} style={`--n: ${i}`}>
              {i === due && (
                <svg viewBox="0 0 24 24">
                  <path d="m6 12.5 4 4L18 8" />
                </svg>
              )}
            </span>
          ))}
        </div>
      </div>
    )
  }

  {
    art === 'file-stack' && (
      <div class="fs">
        {[
          { tag: 'CSV', r: -12, x: -69, y: 8 },
          { tag: 'PDF', r: -4, x: -23, y: -2 },
          { tag: 'XLSX', r: 4, x: 23, y: -2 },
          { tag: 'JSON', r: 12, x: 69, y: 8 },
        ].map((file, n) => (
          <div class="fs-file" style={`--r: ${file.r}deg; --x: ${file.x}px; --y: ${file.y}px; --n: ${n}`}>
            <span class="fs-lines">
              <span style="--w: 80%" />
              <span style="--w: 60%" />
              <span style="--w: 70%" />
            </span>
            <span class="fs-tag">{file.tag}</span>
          </div>
        ))}
      </div>
    )
  }

  {
    art === 'message-check' && (
      <div class="mc">
        <div class="mc-bubble">
          <span style="--w: 86%" />
          <span style="--w: 68%" />
          <span class="mc-link" />
        </div>
        <div class="mc-flag">
          <svg viewBox="0 0 24 24">
            <path d="M10.3 4.2a2 2 0 0 1 3.4 0l7.6 13A2 2 0 0 1 19.6 20H4.4a2 2 0 0 1-1.7-2.8zM12 9.5v4M12 16.6v.01" />
          </svg>
          Check before you tap
        </div>
        <div class="mc-shield">
          <svg viewBox="0 0 24 24">
            <path d="M12 3l7.5 3v5.5c0 4.6-3.2 8.3-7.5 9.5-4.3-1.2-7.5-4.9-7.5-9.5V6zM8.8 12l2.2 2.2 4.3-4.3" />
          </svg>
        </div>
      </div>
    )
  }
</div>

<style>
  .line-art {
    min-height: 11rem;
    background-color: var(--tone-faint);
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
  }
  .glow {
    background: radial-gradient(60% 80% at 70% 0%, var(--tone-soft), transparent 70%);
    opacity: 0.8;
  }
  .line-art :where(svg) {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .df-label,
  .cg-days,
  .fs-tag,
  .mc-flag {
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ── document → fields ── */
  .df {
    position: absolute;
    inset: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .df-doc {
    position: relative;
    flex: none;
    width: 6.25rem;
    height: 8rem;
    padding: 0.9rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    border-radius: 0.5rem;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    box-shadow: var(--shadow-2);
    overflow: hidden;
  }
  .df-doc > span {
    height: 4px;
    width: var(--w);
    border-radius: 2px;
    background: var(--line-strong);
  }
  .df-doc > span:first-child {
    background: var(--ink-3);
    opacity: 0.6;
  }
  .df-scan {
    position: absolute;
    inset-inline: 0;
    top: -30%;
    height: 30%;
    background: linear-gradient(to bottom, transparent, var(--tone-soft));
    border-bottom: 1.5px solid var(--tone);
    opacity: 0;
  }
  .df-link {
    flex: none;
    width: 2.5rem;
    height: 5rem;
    color: var(--tone-line);
    stroke-dasharray: 3 4;
  }
  .df-fields {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .df-field {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.7rem;
    border-radius: 0.55rem;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .df-label {
    width: 3.4rem;
    flex: none;
    font-size: 0.625rem;
    color: var(--ink-3);
  }
  .df-value {
    height: 6px;
    width: var(--w);
    border-radius: 3px;
    background: var(--tone);
    transform-origin: left;
  }

  /* ── plugin toggles ── */
  .pt {
    position: absolute;
    inset: 1.1rem 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
  }
  .pt-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem;
    border-radius: 0.6rem;
    border: 1px solid var(--line);
    background: var(--surface);
    box-shadow: var(--shadow-1);
  }
  .pt-row:nth-child(3) {
    opacity: 0.6;
  }
  .pt-icon {
    width: 1.375rem;
    height: 1.375rem;
    flex: none;
    border-radius: 0.375rem;
    border: 1px solid var(--tone-line);
    background: var(--tone-soft);
  }
  .pt-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .pt-text > span {
    height: 5px;
    width: var(--w);
    border-radius: 3px;
    background: var(--line-strong);
  }
  .pt-text > span:first-child {
    background: var(--ink-3);
    opacity: 0.55;
  }
  .pt-toggle {
    position: relative;
    flex: none;
    width: 1.9rem;
    height: 1.1rem;
    border-radius: 999px;
    background: var(--surface-3);
    transition: background-color 300ms var(--ease);
  }
  .pt-toggle::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: calc(1.1rem - 6px);
    height: calc(1.1rem - 6px);
    border-radius: 50%;
    background: var(--ink-3);
    transition:
      transform 350ms var(--ease),
      background-color 300ms var(--ease);
  }
  .pt-toggle.is-on {
    background: var(--tone);
  }
  .pt-toggle.is-on::after {
    transform: translateX(0.8rem);
    background: var(--canvas);
  }

  /* ── calendar grid ── */
  .cg {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    gap: 0.45rem;
  }
  .cg-days,
  .cg-grid {
    display: grid;
    grid-template-columns: repeat(7, 1.15rem);
    gap: 0.3rem;
  }
  .cg-days {
    font-size: 0.5625rem;
    color: var(--ink-3);
    text-align: center;
  }
  .cg-cell {
    position: relative;
    display: grid;
    place-items: center;
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 0.3rem;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .cg-cell.out {
    opacity: 0.35;
  }
  .cg-cell.mark::after {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--tone);
  }
  .cg-cell.due {
    border-color: var(--tone);
    background: var(--tone);
    color: var(--canvas);
    box-shadow: 0 0 0 4px var(--tone-soft);
  }
  .cg-cell.due svg {
    width: 0.75rem;
    height: 0.75rem;
    stroke-width: 2.6;
  }

  /* ── file stack ── */
  .fs {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .fs-file {
    grid-area: 1 / 1;
    position: relative;
    width: 4.75rem;
    height: 6rem;
    padding: 0.8rem 0.65rem;
    border-radius: 0.5rem;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    box-shadow: var(--shadow-2);
    transform: translate(var(--x), var(--y)) rotate(var(--r));
    transition: transform 600ms var(--ease);
  }
  .fs-file::before {
    content: '';
    position: absolute;
    top: -1px;
    right: -1px;
    width: 1rem;
    height: 1rem;
    border-bottom-left-radius: 0.35rem;
    border-left: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
    background: var(--surface-2);
  }
  .fs-lines {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .fs-lines > span {
    height: 4px;
    width: var(--w);
    border-radius: 2px;
    background: var(--line-strong);
  }
  .fs-tag {
    position: absolute;
    left: 0.55rem;
    bottom: 0.55rem;
    padding: 0.15rem 0.35rem;
    border-radius: 0.25rem;
    font-size: 0.5625rem;
    font-weight: 600;
    color: var(--tone);
    background: var(--tone-soft);
    border: 1px solid var(--tone-line);
  }

  /* ── message check ── */
  .mc {
    position: absolute;
    inset: 1.4rem 1.6rem;
  }
  .mc-bubble {
    position: absolute;
    left: 0;
    top: 0.4rem;
    width: min(68%, 14rem);
    padding: 0.9rem 1rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-radius: 1rem 1rem 1rem 0.25rem;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    box-shadow: var(--shadow-2);
  }
  .mc-bubble > span {
    height: 5px;
    width: var(--w);
    border-radius: 3px;
    background: var(--line-strong);
  }
  .mc-bubble .mc-link {
    width: 54%;
    height: 7px;
    margin-top: 0.2rem;
    background: transparent;
    border-radius: 0;
    border-bottom: 2px dotted var(--danger);
  }
  .mc-flag {
    position: absolute;
    left: 28%;
    bottom: 0.2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.6rem;
    border-radius: 999px;
    font-size: 0.5625rem;
    font-weight: 600;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid color-mix(in oklch, var(--danger) 45%, transparent);
    box-shadow: var(--shadow-2);
    transition: transform 600ms var(--ease);
  }
  .mc-flag svg {
    width: 0.8rem;
    height: 0.8rem;
    color: var(--danger);
  }
  .mc-shield {
    position: absolute;
    right: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.9rem;
    color: var(--tone);
    background: var(--surface);
    border: 1px solid var(--tone-line);
    box-shadow: 0 0 0 6px var(--tone-faint), var(--shadow-2);
  }
  .mc-shield svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  /* ── interaction (only while the parent card is hovered/focused) ── */
  @media (prefers-reduced-motion: no-preference) {
    :global([data-line-card]:is(:hover, :focus-within)) .df-scan {
      animation: scan 2.4s var(--ease) infinite;
    }
    :global([data-line-card]:is(:hover, :focus-within)) .df-value {
      animation: grow 700ms var(--ease) both;
      animation-delay: calc(var(--n) * 140ms + 250ms);
    }
    :global([data-line-card]:is(:hover, :focus-within)) .pt-toggle.flip {
      background: var(--tone);
    }
    :global([data-line-card]:is(:hover, :focus-within)) .pt-toggle.flip::after {
      transform: translateX(0.8rem);
      background: var(--canvas);
    }
    :global([data-line-card]:is(:hover, :focus-within)) .cg-cell.mark::after {
      animation: pop 600ms var(--ease) both;
      animation-delay: calc(var(--n) * 18ms);
    }
    :global([data-line-card]:is(:hover, :focus-within)) .fs-file {
      transform: translate(calc(var(--x) * 1.35), calc(var(--y) - 6px)) rotate(calc(var(--r) * 1.5));
    }
    :global([data-line-card]:is(:hover, :focus-within)) .mc-flag {
      transform: translateY(-4px);
    }
  }
  @keyframes scan {
    0% {
      top: -30%;
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    100% {
      top: 100%;
      opacity: 0;
    }
  }
  @keyframes grow {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  @keyframes pop {
    0% {
      transform: scale(0.2);
    }
    60% {
      transform: scale(1.5);
    }
    100% {
      transform: scale(1);
    }
  }
</style>
