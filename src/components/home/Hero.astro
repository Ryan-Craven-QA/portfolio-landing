---
import { getNavigation } from '../../config/navigation.ts';
import { getSections, site, type Solution } from '../../lib/catalog.ts';
import { routes } from '../../lib/routes.ts';
import Button from '../ui/Button.astro';
import TaskFinder from './TaskFinder.astro';

interface Props {
  solutions: Solution[];
}

const { solutions } = Astro.props;
const { hero } = site;
const primaryCta = getNavigation(site.homepage, await getSections()).cta;
---

<section class="relative overflow-hidden" aria-labelledby="hero-title">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="dot-grid absolute inset-0 [mask-image:radial-gradient(ellipse_75%_65%_at_50%_35%,#000_25%,transparent_75%)]"></div>
    <div class="absolute inset-x-0 top-0 h-[38rem] bg-[radial-gradient(50%_60%_at_50%_0%,var(--accent-soft),transparent_70%)] opacity-60"></div>
    <div class="container-site absolute inset-0 hidden lg:block">
      <div class="h-full border-x border-dashed border-line"></div>
    </div>
  </div>

  <div class="container-site relative pt-14 pb-20 sm:pt-20 lg:pt-24 lg:pb-28">
    <p class="eyebrow enter" style="--i: 0">
      <span class="relative flex size-2" aria-hidden="true">
        <span class="absolute inline-flex size-full animate-ping rounded-full bg-accent opacity-50 motion-reduce:hidden"></span>
        <span class="relative inline-flex size-2 rounded-full bg-accent"></span>
      </span>
      {hero.eyebrow}
    </p>

    <h1 id="hero-title" class="mt-7 max-w-[16ch] text-display-1 text-ink lg:max-w-[18ch]">
      {hero.title}
    </h1>

    <div class="mt-8 grid gap-8 lg:grid-cols-12 lg:items-end">
      <p class="max-w-[36rem] text-lead text-ink-2 lg:col-span-7">{hero.description}</p>
      <div class="enter flex flex-wrap gap-3 lg:col-span-5 lg:justify-end" style="--i: 1">
        <Button href={primaryCta.href} size="lg" arrow="right" class="w-full sm:w-auto">{primaryCta.label}</Button>
        <Button href={routes.about} size="lg" variant="secondary" class="w-full sm:w-auto">About the studio</Button>
      </div>
    </div>

    <div class="mt-14 sm:mt-16">
      <TaskFinder solutions={solutions} />
      <p class="mt-5 hidden items-center justify-center gap-2 text-sm text-ink-3 sm:flex" data-requires-js>
        Press <kbd class="kbd">/</kbd> or <kbd class="kbd"><span data-mod-key>⌘</span>&nbsp;K</kbd> anywhere to search {site.name}.
      </p>
    </div>
  </div>
</section>
