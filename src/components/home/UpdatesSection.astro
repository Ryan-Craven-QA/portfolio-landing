---
import { home } from '../../config/copy.ts';
import { site } from '../../lib/catalog.ts';
import { newsletterTarget } from '../../lib/newsletter.ts';
import NewsletterForm from '../forms/NewsletterForm.astro';
import CornerMarks from '../ui/CornerMarks.astro';

interface Props {
  index?: string;
  /** Drop the top padding when following another padded section. */
  flush?: boolean;
}

const { index, flush = false } = Astro.props;
const hasProvider = newsletterTarget(site) !== null;
const copy = home.updates;
---

<section id="updates" class:list={['section scroll-mt-16', flush && '!pt-0']} aria-labelledby="updates-title">
  <div class="container-site">
    <div class="reveal relative overflow-hidden rounded-[1.25rem] border border-line bg-surface">
      <CornerMarks />
      <div class="dot-grid pointer-events-none absolute inset-0 opacity-60 [mask-image:linear-gradient(to_left,#000,transparent_65%)]" aria-hidden="true"></div>
      <div class="relative grid gap-10 p-7 sm:p-10 lg:grid-cols-2 lg:items-center lg:gap-16 lg:p-14">
        <div>
          <p class="eyebrow">
            {index && <span class="tabular text-ink-2">{index}</span>}
            {copy.eyebrow}
          </p>
          <h2 id="updates-title" class="mt-5 text-display-2 text-ink">{hasProvider ? copy.title : copy.rssTitle}</h2>
          <p class="mt-5 max-w-md text-lead text-ink-2">{hasProvider ? copy.description : copy.rssDescription}</p>
        </div>
        <div class="lg:pl-8">
          <NewsletterForm idPrefix="updates" />
        </div>
      </div>
    </div>
  </div>
</section>
