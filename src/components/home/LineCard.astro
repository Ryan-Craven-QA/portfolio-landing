---
import type { Line } from '../../lib/catalog.ts';
import LineGlyph from '../brand/LineGlyph.astro';
import Icon from '../ui/Icon.astro';
import LineStatusBadge from '../ui/LineStatusBadge.astro';
import LineArt from './LineArt.astro';

interface Props {
  line: Line;
  productCount: number;
  /** Wide horizontal layout, used when a single line is visible. */
  wide?: boolean;
  class?: string;
  style?: string;
}

const { line, productCount, wide = false, class: className, style } = Astro.props;
const examples = line.examples.slice(0, wide ? 6 : 4);
---

<article
  data-line-card
  class:list={['card card-interactive spotlight group flex flex-col overflow-hidden', wide && 'md:flex-row-reverse', className]}
  style={`--tone-h: ${line.hue};${style ?? ''}`}
>
  <LineArt art={line.art} hue={line.hue} class:list={['border-line', wide ? 'border-b md:w-[46%] md:border-b-0 md:border-l' : 'border-b']} />

  <div class:list={['relative flex flex-1 flex-col p-6', wide && 'md:p-10']}>
    <div class="flex items-start justify-between gap-4">
      <LineGlyph glyph={line.glyph} hue={line.hue} />
      <div class="flex flex-wrap justify-end gap-2">
        <LineStatusBadge line={line} />
      </div>
    </div>

    <h3 class:list={['mt-5 font-[620] tracking-[-0.02em] text-ink', wide ? 'text-display-3' : 'text-xl']}>
      <a href={line.url} class="card-link">{line.name}</a>
    </h3>
    <p class="mt-2 text-[0.9375rem] text-ink-2">{line.tagline}</p>

    <div class="mt-6">
      <p class="eyebrow mb-3 text-[0.65rem]">{productCount > 0 ? 'Includes' : 'In the works'}</p>
      <ul class="flex flex-wrap gap-1.5">
        {
          examples.map((example) => (
            <li class="rounded-md border border-line bg-surface-2/60 px-2 py-1 text-[0.8125rem] leading-tight text-ink-2">{example}</li>
          ))
        }
      </ul>
    </div>

    <div class="mt-auto flex items-center justify-between pt-7 text-sm">
      <span class="text-ink-3">
        {productCount > 0 ? `${productCount} product${productCount === 1 ? '' : 's'} available` : 'No releases yet'}
      </span>
      <span class="inline-flex items-center gap-1.5 font-medium text-ink transition-colors group-hover:text-tone" aria-hidden="true">
        Explore
        <Icon name="arrow-right" size={15} class="transition-transform duration-300 group-hover:translate-x-0.5" />
      </span>
    </div>
  </div>
</article>
