---
/**
 * Section header with the drafting-style index rule:
 *   01 ────────────── Product lines
 *   Display title
 *   Supporting description
 */
interface Props {
  index?: string;
  eyebrow: string;
  title: string;
  description?: string | undefined;
  id?: string | undefined;
  align?: 'start' | 'center';
  as?: 'h1' | 'h2';
  class?: string;
}

const { index, eyebrow, title, description, id, align = 'start', as: Tag = 'h2', class: className } = Astro.props;
const hasActions = Astro.slots.has('actions');
---

<div class:list={['reveal', className]}>
  <div class="mb-7 flex items-center gap-4" aria-hidden="true">
    {index && <span class="eyebrow tabular text-ink-2">{index}</span>}
    <span class="hairline-x flex-1"></span>
    <span class="eyebrow">{eyebrow}</span>
  </div>
  <div
    class:list={[
      'flex flex-col gap-6',
      align === 'center' ? 'items-center text-center' : 'md:flex-row md:items-end md:justify-between',
    ]}
  >
    <div class:list={['max-w-[44rem]', align === 'center' && 'mx-auto']}>
      <span class="sr-only">{eyebrow}: </span>
      <Tag id={id} class="text-display-2 text-ink">{title}</Tag>
      {description && <p class="mt-5 text-lead text-ink-2">{description}</p>}
    </div>
    {hasActions && (
      <div class="flex shrink-0 flex-wrap gap-3">
        <slot name="actions" />
      </div>
    )}
  </div>
</div>
