---
/** Header for inner pages: breadcrumbs, eyebrow, H1, lead and optional extras. */
import Breadcrumbs, { type Crumb } from './Breadcrumbs.astro';

interface Props {
  eyebrow: string;
  title: string;
  description?: string | undefined;
  breadcrumbs?: Crumb[] | undefined;
  class?: string;
}

const { eyebrow, title, description, breadcrumbs, class: className } = Astro.props;
---

<header class:list={['relative overflow-hidden border-b border-line', className]}>
  <div class="dot-grid fade-mask-radial pointer-events-none absolute inset-0 opacity-70" aria-hidden="true"></div>
  <div class="container-site relative pt-12 pb-14 md:pt-16 md:pb-20">
    {breadcrumbs && <Breadcrumbs items={breadcrumbs} class="enter mb-10" />}
    <p class="eyebrow enter" style="--i: 1">
      <span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
      {eyebrow}
    </p>
    <h1 class="mt-5 max-w-[22ch] text-display-1 text-ink">{title}</h1>
    {description && <p class="mt-6 max-w-[40rem] text-lead text-ink-2">{description}</p>}
    {
      Astro.slots.has('default') && (
        <div class="enter mt-9" style="--i: 4">
          <slot />
        </div>
      )
    }
  </div>
</header>
