---
import { getNavigation, isActive } from '../../config/navigation.ts';
import { getCatalog, getSections, site } from '../../lib/catalog.ts';
import Logo from '../brand/Logo.astro';
import LineGlyph from '../brand/LineGlyph.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;
const { lines } = await getCatalog();
const navigation = getNavigation(site.homepage, await getSections());
const primaryNav = navigation.primary;
const primaryCta = navigation.cta;
const showSearch = site.features.search;
---

<header
  data-site-header
  class="group/header sticky top-0 z-40 border-b border-transparent bg-canvas/75 backdrop-blur-xl backdrop-saturate-150 transition-colors duration-300 data-[scrolled]:border-line"
  style="view-transition-name: site-header"
>
  <div class="container-site flex h-16 items-center gap-4 lg:gap-8">
    <Logo />

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-0.5">
        {
          primaryNav.map((item) => {
            const active = isActive(item, pathname);
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'relative rounded-md px-3 py-2 text-[0.9375rem] font-[520] transition-colors',
                    active ? 'text-ink' : 'text-ink-2 hover:text-ink',
                  ]}
                >
                  {item.label}
                  {active && <span class="absolute inset-x-3 -bottom-[13px] h-px bg-accent" aria-hidden="true" />}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-1">
      {
        showSearch && (
          <>
            <button
              type="button"
              data-search-open
              data-requires-js
              aria-haspopup="dialog"
              aria-controls="search-dialog"
              class="group/search hidden h-9 items-center gap-2 rounded-[var(--radius-control)] border border-line bg-surface/60 pr-1.5 pl-3 text-sm text-ink-3 transition-colors hover:border-line-strong hover:text-ink-2 xl:inline-flex"
            >
              <Icon name="search" size={15} />
              <span class="pr-6">Search</span>
              <kbd class="kbd" data-shortcut-hint>
                /
              </kbd>
            </button>
            <button type="button" data-search-open data-requires-js aria-label="Search" aria-haspopup="dialog" class="icon-btn xl:hidden">
              <Icon name="search" size={18} />
            </button>
          </>
        )
      }
      <ThemeToggle />
      <Button href={primaryCta.href} size="sm" class="ml-1.5 hidden sm:inline-flex" arrow="right">{primaryCta.label}</Button>
      <button
        type="button"
        class="icon-btn lg:hidden"
        data-menu-open
        data-requires-js
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <Icon name="menu" size={20} />
      </button>
    </div>
  </div>
</header>

<dialog
  id="mobile-menu"
  aria-label="Menu"
  class="m-0 h-dvh max-h-none w-full max-w-none bg-transparent p-0 backdrop:bg-[var(--overlay)] backdrop:backdrop-blur-sm open:flex lg:hidden"
>
  <div class="ml-auto flex h-full w-full max-w-sm flex-col border-l border-line bg-canvas shadow-2xl">
    <div class="flex h-16 items-center justify-between border-b border-line px-5">
      <span class="eyebrow">Menu</span>
      <button type="button" class="icon-btn -mr-2" data-menu-close aria-label="Close menu">
        <Icon name="x" size={20} />
      </button>
    </div>
    <nav aria-label="Mobile" class="flex-1 overflow-y-auto px-3 py-4">
      <ul class="space-y-0.5">
        {
          primaryNav.map((item) => {
            const active = isActive(item, pathname);
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'flex items-center justify-between rounded-lg px-3 py-3 text-lg font-[560] tracking-tight transition-colors',
                    active ? 'bg-surface-2 text-ink' : 'text-ink-2 hover:bg-surface-2 hover:text-ink',
                  ]}
                >
                  {item.label}
                  <Icon name="chevron-right" size={16} class="text-ink-3" />
                </a>
              </li>
            );
          })
        }
      </ul>
      {
        lines.length > 0 && (
          <div class="mt-6 border-t border-line px-3 pt-6">
            <p class="eyebrow mb-3">Product lines</p>
            <ul class="space-y-1">
              {lines.map((line) => (
                <li>
                  <a href={line.url} class="flex items-center gap-3 rounded-lg py-2 text-[0.9375rem] text-ink-2 hover:text-ink">
                    <LineGlyph glyph={line.glyph} hue={line.hue} size="sm" />
                    {line.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </nav>
    <div class="flex items-center gap-2 border-t border-line p-4">
      <Button href={primaryCta.href} class="flex-1" arrow="right">{primaryCta.label}</Button>
      <ThemeToggle class="border border-line" />
    </div>
  </div>
</dialog>
