---
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import { shouldNoIndex } from '../../config/load.ts';
import { site } from '../../lib/catalog.ts';
import Analytics from './Analytics.astro';

export interface HeadProps {
  /** Page title; the brand name is appended unless `rawTitle` is set. */
  title: string;
  rawTitle?: boolean;
  description?: string | undefined;
  image?: string | ImageMetadata | undefined;
  imageAlt?: string | undefined;
  type?: 'website' | 'article' | 'product';
  noindex?: boolean;
  publishedTime?: Date | undefined;
  modifiedTime?: Date | undefined;
}

const {
  title,
  rawTitle = false,
  description = site.description,
  image,
  imageAlt,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
} = Astro.props as HeadProps;

const siteUrl = (Astro.site?.href ?? `${site.url}/`).replace(/\/$/, '');
const fullTitle = rawTitle ? title : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, `${siteUrl}/`).href;
const robots = noindex || shouldNoIndex(siteUrl) ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';

let ogImagePath = '/og/default.png';
let ogWidth = 1200;
let ogHeight = 630;
if (typeof image === 'string') {
  ogImagePath = image;
} else if (image) {
  const optimized = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'png' });
  ogImagePath = optimized.src;
}
const ogImage = new URL(ogImagePath, `${siteUrl}/`).href;
const ogAlt = imageAlt ?? `${site.name} — ${site.tagline}`;

// Applied before first paint: dark by default, stored choice wins.
const themeScript = `(()=>{const d=document.documentElement;d.classList.add('js','reveal-ready');try{const t=localStorage.getItem('theme');if(t==='light'||t==='dark')d.dataset.theme=t}catch(e){}})();`;
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={robots} />
  <meta name="color-scheme" content="dark light" />
  <meta name="theme-color" content="#0d0c0b" />
  <meta name="format-detection" content="telephone=no" />

  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="alternate" type="application/rss+xml" title={`${site.name} — updates`} href="/rss.xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <meta property="og:type" content={type === 'product' ? 'product' : type} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content={String(ogWidth)} />
  <meta property="og:image:height" content={String(ogHeight)} />
  <meta property="og:image:alt" content={ogAlt} />
  <meta property="og:locale" content={site.locale.replace('-', '_')} />
  {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
  {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={ogAlt} />

  <Font cssVariable="--font-mona" preload />
  <Font cssVariable="--font-geist" />
  <script is:inline set:html={themeScript} />
  <Analytics />
  <slot />
</head>
