---
import { Image } from 'astro:assets';
import type { Product } from '../../lib/catalog.ts';
import ProductCover from './ProductCover.astro';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const shots = product.data.screenshots;
---

<div class="space-y-4">
  <ProductCover product={product} size="hero" priority />
  {
    shots.length > 0 && (
      <ul class:list={['grid gap-4', shots.length === 1 ? 'grid-cols-1' : 'grid-cols-2']}>
        {shots.map((shot) => (
          <li>
            <figure>
              <Image
                src={shot.src}
                alt={shot.alt}
                widths={[400, 640, 960]}
                sizes={shots.length === 1 ? '(min-width: 1024px) 640px, 100vw' : '(min-width: 1024px) 320px, 50vw'}
                class="w-full rounded-[var(--radius-control)] border border-line"
                loading="lazy"
              />
              {shot.caption && <figcaption class="mt-2 text-sm text-ink-3">{shot.caption}</figcaption>}
            </figure>
          </li>
        ))}
      </ul>
    )
  }
</div>
