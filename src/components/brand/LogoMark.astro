---
/**
 * The mark: a selection frame around a solid block — "the work, in focus".
 * Keep in sync with public/favicon.svg (generated by `npm run assets:icons`).
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 24, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  class:list={['shrink-0', className]}
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M3 8.5v-4A1.5 1.5 0 0 1 4.5 3h4M15.5 3h4A1.5 1.5 0 0 1 21 4.5v4M21 15.5v4a1.5 1.5 0 0 1-1.5 1.5h-4M8.5 21h-4A1.5 1.5 0 0 1 3 19.5v-4"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"></path>
  <rect x="7.75" y="7.75" width="8.5" height="8.5" rx="1.75" fill="var(--accent)"></rect>
</svg>
