---
import { about, home } from '../config/copy.ts';
import LineGlyph from '../components/brand/LineGlyph.astro';
import PrinciplesGrid from '../components/home/PrinciplesGrid.astro';
import Button from '../components/ui/Button.astro';
import ConfigNotice from '../components/ui/ConfigNotice.astro';
import CornerMarks from '../components/ui/CornerMarks.astro';
import Icon from '../components/ui/Icon.astro';
import LineStatusBadge from '../components/ui/LineStatusBadge.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCatalog, site } from '../lib/catalog.ts';
import { routes } from '../lib/routes.ts';
import { breadcrumbLd, organizationLd } from '../lib/seo.ts';

const { lines } = await getCatalog();
const founder = site.founder;
const siteUrl = (Astro.site?.href ?? site.url).replace(/\/$/, '');
---

<BaseLayout
  title="About"
  description={`${site.name} is an independent studio building practical software, templates, and guides for everyday work.`}
  jsonLd={[organizationLd(site, siteUrl), breadcrumbLd([{ label: 'Home', href: '/' }, { label: 'About', href: routes.about }], siteUrl)]}
>
  <PageHeader eyebrow={about.eyebrow} title={about.title} description={about.description} breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'About' }]} />

  <section class="container-site section" aria-label="What we do">
    <div class="grid gap-10 lg:grid-cols-12">
      <p class="reveal text-display-3 text-ink lg:col-span-5">{about.statement}</p>
      <div class="reveal space-y-5 text-lead text-ink-2 lg:col-span-6 lg:col-start-7">
        {about.intro.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="border-t border-line" aria-labelledby="how-title">
    <div class="container-site section">
      <h2 id="how-title" class="eyebrow mb-8">How the studio works</h2>
      <ul class="grid gap-4 md:grid-cols-3">
        {
          about.howWeWork.map((item, i) => (
            <li class="reveal card relative p-7" style={`--i: ${i}`}>
              <span class="mono text-xs text-accent">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-4 text-xl font-[620] tracking-[-0.02em] text-ink">{item.title}</h3>
              <p class="mt-2 text-ink-2">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    founder && (
      <section class="border-t border-line" aria-labelledby="founder-title">
        <div class="container-site section grid gap-10 lg:grid-cols-12 lg:items-center">
          {founder.photo && (
            <div class="relative lg:col-span-4">
              <CornerMarks class="-inset-3" />
              <img
                src={founder.photo}
                alt={founder.photoAlt ?? `Portrait of ${founder.name}`}
                width="480"
                height="560"
                loading="lazy"
                class="aspect-[6/7] w-full rounded-[var(--radius-card)] border border-line object-cover"
              />
            </div>
          )}
          <div class:list={[founder.photo ? 'lg:col-span-7 lg:col-start-6' : 'lg:col-span-8']}>
            <p class="eyebrow">Founder</p>
            <h2 id="founder-title" class="mt-4 text-display-2 text-ink">
              {founder.name}
            </h2>
            <p class="mt-2 text-ink-3">{founder.role}</p>
            <div class="mt-6 space-y-4 text-lead text-ink-2">
              {founder.bio.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
            {founder.links.length > 0 && (
              <ul class="mt-6 flex flex-wrap gap-4 text-sm">
                {founder.links.map((link) => (
                  <li>
                    <a href={link.url} class="link inline-flex items-center gap-1" rel="noopener">
                      {link.label} <Icon name="arrow-up-right" size={13} />
                      <span class="sr-only">(opens an external site)</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      </section>
    )
  }
  {
    !founder && (
      <div class="container-site">
        <ConfigNotice title="Founder section hidden">
          Add <code>founder</code> to <code>src/config/site.ts</code> (in your own words) to show a founder profile here.
        </ConfigNotice>
      </div>
    )
  }

  {
    lines.length > 0 && (
      <section class="border-t border-line" aria-labelledby="about-lines-title">
        <div class="container-site section">
          <SectionHeading id="about-lines-title" eyebrow="Product lines" title="What we make." class="mb-10" />
          <ul class="divide-y divide-line border-y border-line">
            {lines.map((line) => (
              <li style={`--tone-h: ${line.hue}`}>
                <a href={line.url} class="group grid gap-3 py-6 sm:grid-cols-[auto_1fr_auto] sm:items-center sm:gap-6">
                  <LineGlyph glyph={line.glyph} hue={line.hue} />
                  <span>
                    <span class="block text-lg font-[620] text-ink transition-colors group-hover:text-tone">{line.name}</span>
                    <span class="block text-ink-2">{line.tagline}</span>
                  </span>
                  <span class="flex items-center gap-3">
                    <LineStatusBadge line={line} />
                    <Icon name="arrow-right" size={16} class="text-ink-3 transition-transform group-hover:translate-x-0.5" />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="border-t border-line" aria-labelledby="about-principles-title">
    <div class="container-site section">
      <SectionHeading id="about-principles-title" eyebrow={home.principles.eyebrow} title={home.principles.title} description={home.principles.description} class="mb-12" />
      <PrinciplesGrid />
    </div>
  </section>

  <section class="border-t border-line" aria-labelledby="about-cta-title">
    <div class="container-site flex flex-col items-start gap-6 py-14 md:flex-row md:items-center md:justify-between md:py-20">
      <h2 id="about-cta-title" class="max-w-xl text-display-3 text-ink">Have a question, an idea, or a job that needs a better tool?</h2>
      <div class="flex flex-wrap gap-3">
        <Button href={routes.contact} arrow="right">Get in touch</Button>
        <Button href={routes.products} variant="secondary">Explore products</Button>
      </div>
    </div>
  </section>
</BaseLayout>
