---
/**
 * Product detail page — generated ONLY for public products of public lines
 * (or every product in `npm run dev:drafts`).
 */
import { render } from 'astro:content';
import ProductCard from '../../../components/products/ProductCard.astro';
import AvailabilityBadge from '../../../components/products/AvailabilityBadge.astro';
import OfferList from '../../../components/products/OfferList.astro';
import ProductGallery from '../../../components/products/ProductGallery.astro';
import ResourceCard from '../../../components/resources/ResourceCard.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import Callout from '../../../components/ui/Callout.astro';
import FaqList from '../../../components/ui/FaqList.astro';
import Icon from '../../../components/ui/Icon.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCatalog, getRelatedProducts, getResourcesForProduct, site } from '../../../lib/catalog.ts';
import { formatDate } from '../../../lib/format.ts';
import { isExternal, routes } from '../../../lib/routes.ts';
import { breadcrumbLd, productLd } from '../../../lib/seo.ts';

export async function getStaticPaths() {
  const { products } = await getCatalog();
  return products.map((product) => ({ params: { line: product.line.id, product: product.id }, props: { productId: product.id } }));
}

const { productId } = Astro.props;
const { productsById } = await getCatalog();
const product = productsById.get(productId)!;
const { data, line } = product;
const { Content } = await render(product.entry);
const related = await getRelatedProducts(product);
const guides = await getResourcesForProduct(product);
const bundled = data.bundleIncludes.map((id) => productsById.get(id)).filter((p) => p !== undefined);
const siteUrl = (Astro.site?.href ?? site.url).replace(/\/$/, '');
const notifyHref = '/#updates';

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Products', href: routes.products },
  { label: line.name, href: line.url },
  { label: product.name, href: product.url },
];

const coverUrl = data.cover ? new URL(data.cover.src.src, `${siteUrl}/`).href : undefined;
const structured = [breadcrumbLd(crumbs, siteUrl), productLd(product, site, siteUrl, coverUrl)].filter((x) => x !== null);

const facts = [
  { label: 'Product line', value: line.name, href: line.url },
  { label: 'Type', value: product.typeLabel },
  product.pricingModel ? { label: 'Pricing', value: product.pricingModel } : null,
  data.version ? { label: 'Version', value: data.version } : null,
  data.releaseDate ? { label: 'Released', value: formatDate(data.releaseDate, site.locale) } : null,
  data.updatedDate ? { label: 'Updated', value: formatDate(data.updatedDate, site.locale) } : null,
  data.formats.length > 0 ? { label: 'Formats', value: data.formats.join(', ') } : null,
].filter((fact) => fact !== null);

const links = [
  data.links.documentation ? { label: 'Documentation', href: data.links.documentation, icon: 'book' as const } : null,
  data.links.support ? { label: 'Support', href: data.links.support, icon: 'lifebuoy' as const } : { label: 'Get support', href: routes.contactTopic('support', product.id), icon: 'lifebuoy' as const },
  data.links.changelog ? { label: 'Changelog', href: data.links.changelog, icon: 'list' as const } : null,
  data.links.demo ? { label: 'Live demo', href: data.links.demo, icon: 'eye' as const } : null,
].filter((link) => link !== null);
---

<BaseLayout
  title={data.seo?.title ?? product.name}
  description={data.seo?.description ?? product.summary}
  image={data.cover?.src}
  imageAlt={data.cover?.alt}
  type="product"
  jsonLd={structured}
>
  {
    product.isPreview && (
      <div class="border-b border-line bg-[color-mix(in_oklch,var(--danger)_8%,transparent)]">
        <p class="container-site py-3 text-sm text-ink-2">
          <strong class="text-ink">Draft.</strong> This product is not public — it appears only in draft preview. Set <code class="mono">visibility: public</code> to publish it.
        </p>
      </div>
    )
  }

  <section class="container-site pt-10 pb-14 md:pb-20" style={`--tone-h: ${line.hue}`}>
    <Breadcrumbs items={crumbs.map((crumb, i) => (i === crumbs.length - 1 ? { label: crumb.label } : crumb))} class="mb-10" />
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="order-2 lg:order-none lg:col-span-7">
        <ProductGallery product={product} />
      </div>

      <!-- On small screens the panel's children join the grid (display: contents) so the
           order is: name → images → pricing. On desktop it is one sticky column. -->
      <div class="contents lg:sticky lg:top-24 lg:col-span-5 lg:block lg:self-start">
        <div class="order-1 lg:order-none">
        <p class="flex items-center gap-2 text-sm text-ink-3">
          <span class="size-1.5 rounded-full bg-tone" aria-hidden="true"></span>
          <a href={line.url} class="transition-colors hover:text-ink">{line.name}</a>
          <span aria-hidden="true">·</span>
          {product.typeLabel}
        </p>
        <h1 class="mt-4 text-display-2 text-ink">{product.name}</h1>
        {data.tagline && <p class="mt-4 text-lead text-ink">{data.tagline}</p>}
        <p class="mt-4 text-ink-2">{product.summary}</p>
        <AvailabilityBadge product={product} class="mt-6" />
        </div>

        <div class="order-3 lg:order-none">
        <div class="lg:mt-7">
          <OfferList product={product} notifyHref={notifyHref} />
        </div>

        <dl class="mt-8 divide-y divide-line border-y border-line text-sm">
          {
            facts.map((fact) => (
              <div class="flex justify-between gap-6 py-3">
                <dt class="text-ink-3">{fact.label}</dt>
                <dd class="text-right text-ink">
                  {'href' in fact && fact.href ? (
                    <a href={fact.href} class="link">
                      {fact.value}
                    </a>
                  ) : (
                    fact.value
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-line" aria-labelledby="overview-title">
    <div class="container-site grid gap-12 py-14 md:py-20 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h2 id="overview-title" class="eyebrow mb-6">Overview</h2>
        <div class="prose">
          <Content />
        </div>
        {line.disclaimer && <Callout tone="caution" class="mt-10" title="Please note">{line.disclaimer}</Callout>}
      </div>
      <div class="space-y-10 lg:col-span-4 lg:col-start-9">
        {
          data.includes.length > 0 && (
            <div>
              <h2 class="eyebrow mb-4">What’s included</h2>
              <ul class="space-y-2.5 text-[0.9375rem] text-ink-2">
                {data.includes.map((item) => (
                  <li class="flex items-start gap-2.5">
                    <Icon name="check" size={16} class="mt-0.5 text-tone" />
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        {
          bundled.length > 0 && (
            <div>
              <h2 class="eyebrow mb-4">In this bundle</h2>
              <ul class="space-y-2 text-[0.9375rem]">
                {bundled.map((item) => (
                  <li>
                    <a href={item.url} class="link">
                      {item.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        {
          data.requirements.length > 0 && (
            <div>
              <h2 class="eyebrow mb-4">Requirements</h2>
              <ul class="space-y-2.5 text-[0.9375rem] text-ink-2">
                {data.requirements.map((item) => (
                  <li class="flex items-start gap-2.5">
                    <Icon name="info" size={16} class="mt-0.5 text-ink-3" />
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        <div>
          <h2 class="eyebrow mb-4">Help and documentation</h2>
          <ul class="space-y-1">
            {
              links.map((link) => (
                <li>
                  <a href={link.href} class="group flex items-center gap-3 rounded-lg py-2 text-[0.9375rem] text-ink-2 transition-colors hover:text-ink" rel={isExternal(link.href) ? 'noopener' : undefined}>
                    <Icon name={link.icon} size={16} class="text-ink-3" />
                    <span class="flex-1">{link.label}</span>
                    <Icon name={isExternal(link.href) ? 'arrow-up-right' : 'arrow-right'} size={14} class="text-ink-3 transition-transform group-hover:translate-x-0.5" />
                    {isExternal(link.href) && <span class="sr-only">(opens an external site)</span>}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  {
    data.highlights.length > 0 && (
      <section class="border-t border-line" aria-labelledby="highlights-title" style={`--tone-h: ${line.hue}`}>
        <div class="container-site py-14 md:py-20">
          <h2 id="highlights-title" class="text-display-3 text-ink">
            Highlights
          </h2>
          <ul class="mt-10 grid gap-px overflow-hidden rounded-[var(--radius-card)] border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
            {data.highlights.map((highlight, i) => (
              <li class="reveal bg-canvas p-7" style={`--i: ${i}`}>
                <span class="mono text-xs text-tone">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="mt-4 text-lg font-[620] text-ink">{highlight.title}</h3>
                <p class="mt-2 text-[0.9375rem] text-ink-2">{highlight.body}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    data.faqs.length > 0 && (
      <section class="border-t border-line" aria-labelledby="product-faq-title">
        <div class="container-site grid gap-10 py-14 md:py-20 lg:grid-cols-12">
          <h2 id="product-faq-title" class="text-display-3 text-ink lg:col-span-4">
            Questions
          </h2>
          <FaqList
            class="lg:col-span-8"
            items={data.faqs.map((faq) => ({ question: faq.question, paragraphs: faq.answer.split(/\n\s*\n/).map((p) => p.trim()) }))}
          />
        </div>
      </section>
    )
  }

  {
    guides.length > 0 && (
      <section class="border-t border-line" aria-labelledby="guides-title">
        <div class="container-site py-14 md:py-20">
          <h2 id="guides-title" class="text-display-3 text-ink">
            Guides and documentation
          </h2>
          <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {guides.slice(0, 3).map((resource) => (
              <ResourceCard resource={resource} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="border-t border-line" aria-labelledby="related-title">
        <div class="container-site py-14 md:py-20">
          <h2 id="related-title" class="text-display-3 text-ink">
            Related products
          </h2>
          <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((item) => (
              <ProductCard product={item} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
