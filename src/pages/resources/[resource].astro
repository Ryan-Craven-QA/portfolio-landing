---
import { render } from 'astro:content';
import ProductCard from '../../components/products/ProductCard.astro';
import ResourceCard from '../../components/resources/ResourceCard.astro';
import Badge from '../../components/ui/Badge.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCatalog, site } from '../../lib/catalog.ts';
import { formatDate } from '../../lib/format.ts';
import { isExternal, routes } from '../../lib/routes.ts';
import { articleLd, breadcrumbLd } from '../../lib/seo.ts';

export async function getStaticPaths() {
  const { resources } = await getCatalog();
  return resources.map((resource) => ({ params: { resource: resource.id }, props: { resourceId: resource.id } }));
}

const { resourceId } = Astro.props;
const { resources } = await getCatalog();
const resource = resources.find((r) => r.id === resourceId)!;
const { Content, headings } = await render(resource.entry);
const toc = headings.filter((heading) => heading.depth === 2);
const download = resource.data.download;
const related = resources
  .filter((r) => r.id !== resource.id && (r.line?.id === resource.line?.id || r.type === resource.type))
  .slice(0, 3);
const siteUrl = (Astro.site?.href ?? site.url).replace(/\/$/, '');
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Resources', href: routes.resources },
  { label: resource.title, href: resource.url },
];
const hue = resource.line?.hue;
---

<BaseLayout
  title={resource.data.seo?.title ?? resource.title}
  description={resource.data.seo?.description ?? resource.description}
  image={resource.data.cover?.src}
  imageAlt={resource.data.cover?.alt}
  type="article"
  publishedTime={resource.publishDate}
  modifiedTime={resource.updatedDate}
  jsonLd={[breadcrumbLd(crumbs, siteUrl), articleLd(resource, site, siteUrl)]}
>
  <article style={hue !== undefined ? `--tone-h: ${hue}` : undefined}>
    <header class="relative overflow-hidden border-b border-line">
      <div class="dot-grid fade-mask-radial pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
      <div class="container-site relative pt-12 pb-12 md:pt-16 md:pb-16">
        <Breadcrumbs items={[...crumbs.slice(0, -1), { label: resource.typeLabel }]} class="enter mb-10" />
        <div class="enter flex flex-wrap items-center gap-2" style="--i: 1">
          {resource.isPreview && <Badge tone="draft">Draft</Badge>}
          <Badge tone={hue !== undefined ? 'tone' : 'neutral'} dot={false}>{resource.typeLabel}</Badge>
          {resource.line && <a href={resource.line.url} class="badge transition-colors hover:text-ink">{resource.line.name}</a>}
        </div>
        <h1 class="mt-6 max-w-[24ch] text-display-2 text-ink">{resource.title}</h1>
        <p class="mt-5 max-w-[40rem] text-lead text-ink-2">{resource.description}</p>
        <p class="enter mono mt-8 flex flex-wrap gap-x-5 gap-y-2 text-xs tracking-wide text-ink-3 uppercase" style="--i: 4">
          <span>
            Published <time datetime={resource.publishDate.toISOString()}>{formatDate(resource.publishDate, site.locale)}</time>
          </span>
          {
            resource.updatedDate && (
              <span>
                Updated <time datetime={resource.updatedDate.toISOString()}>{formatDate(resource.updatedDate, site.locale)}</time>
              </span>
            )
          }
          <span>{resource.readingMinutes} min read</span>
        </p>
      </div>
    </header>

    <div class="container-site grid gap-12 py-12 md:py-16 lg:grid-cols-12">
      <div class="min-w-0 lg:col-span-8">
        <div class="prose">
          <Content />
        </div>

        {
          download && (
            <div class="card relative mt-14 flex flex-col gap-5 overflow-hidden p-6 sm:flex-row sm:items-center sm:justify-between" id="download">
              <div class="flex items-center gap-4">
                <span class="mono grid size-12 shrink-0 place-items-center rounded-xl border border-line-strong bg-surface-2 text-xs font-semibold text-ink-2">
                  {download.format}
                </span>
                <div>
                  <p class="font-[620] text-ink">{download.label}</p>
                  <p class="text-sm text-ink-3">
                    Free download · {download.format}
                    {download.size && ` · ${download.size}`}
                  </p>
                </div>
              </div>
              {isExternal(download.href) ? (
                <Button href={download.href} external>
                  Download
                </Button>
              ) : (
                <Button href={download.href} icon="download" download data-download>
                  Download
                </Button>
              )}
            </div>
          )
        }

        <div class="mt-12 flex flex-wrap items-center gap-3 border-t border-line pt-8 text-sm" data-requires-js>
          <button type="button" class="btn btn-secondary btn-sm" data-print>
            <Icon name="printer" size={15} /> Print this {resource.type === 'download' ? 'page' : 'guide'}
          </button>
          <button type="button" class="btn btn-ghost btn-sm" data-copy-link>
            <Icon name="link" size={15} /> <span data-copy-label>Copy link</span>
          </button>
        </div>
      </div>

      <aside class="no-print lg:col-span-3 lg:col-start-10">
        <div class="space-y-10 lg:sticky lg:top-24">
          {
            toc.length > 1 && (
              <nav aria-labelledby="toc-title">
                <h2 id="toc-title" class="eyebrow mb-4">
                  On this page
                </h2>
                <ol class="space-y-2 border-l border-line text-sm">
                  {toc.map((heading) => (
                    <li>
                      <a href={`#${heading.slug}`} class="-ml-px block border-l border-transparent py-0.5 pl-4 text-ink-3 transition-colors hover:border-ink-3 hover:text-ink">
                        {heading.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            )
          }
          {
            download && (
              <a href="#download" class="flex items-center gap-2 text-sm font-medium text-ink hover:text-accent">
                <Icon name="download" size={15} /> Jump to the download
              </a>
            )
          }
          {
            resource.products.length > 0 && (
              <div>
                <h2 class="eyebrow mb-4">Related products</h2>
                <ul class="space-y-2 text-sm">
                  {resource.products.map((product) => (
                    <li>
                      <a href={product.url} class="link">
                        {product.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>
      </aside>
    </div>
  </article>

  {
    resource.products.length > 0 && (
      <section class="border-t border-line" aria-labelledby="resource-products-title">
        <div class="container-site py-14 md:py-20">
          <h2 id="resource-products-title" class="text-display-3 text-ink">
            Tools for this
          </h2>
          <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {resource.products.slice(0, 3).map((product) => (
              <ProductCard product={product} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="no-print border-t border-line" aria-labelledby="related-resources-title">
        <div class="container-site py-14 md:py-20">
          <h2 id="related-resources-title" class="text-display-3 text-ink">
            Keep reading
          </h2>
          <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {related.map((item) => (
              <ResourceCard resource={item} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  document.querySelectorAll('[data-print]').forEach((button) => button.addEventListener('click', () => window.print()));
  document.querySelectorAll<HTMLElement>('[data-copy-link]').forEach((button) =>
    button.addEventListener('click', async () => {
      const label = button.querySelector('[data-copy-label]');
      try {
        await navigator.clipboard.writeText(window.location.href.split('#')[0] ?? window.location.href);
        if (label) label.textContent = 'Link copied';
      } catch {
        if (label) label.textContent = 'Copy failed — use the address bar';
      }
      window.setTimeout(() => label && (label.textContent = 'Copy link'), 2500);
    }),
  );
</script>
