---
import Button from '../components/ui/Button.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import FaqList from '../components/ui/FaqList.astro';
import Icon from '../components/ui/Icon.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CAN_CONTACT, getCatalog, site, type Faq } from '../lib/catalog.ts';
import { pluralize } from '../lib/format.ts';
import { routes } from '../lib/routes.ts';
import { breadcrumbLd } from '../lib/seo.ts';

const { faqs, resources } = await getCatalog();
const docs = resources.filter((resource) => resource.type === 'documentation');
const guides = resources.filter((resource) => resource.type === 'guide' || resource.type === 'tutorial');
const siteUrl = (Astro.site?.href ?? site.url).replace(/\/$/, '');

const groups: Array<{ id: Faq['category']; title: string }> = [
  { id: 'purchasing', title: 'Buying and licensing' },
  { id: 'products', title: 'Products' },
  { id: 'support', title: 'Getting help' },
  { id: 'general', title: 'General' },
];

const cards = [
  {
    icon: 'book' as const,
    title: 'Documentation',
    body: docs.length > 0 ? `${pluralize(docs.length, 'product guide')} covering setup and everyday use.` : 'Product documentation is published alongside each release.',
    href: docs.length > 0 ? `${routes.resources}?type=documentation` : routes.resources,
    cta: docs.length > 0 ? 'Read the docs' : 'Browse the library',
  },
  {
    icon: 'file' as const,
    title: 'Guides and tutorials',
    body: guides.length > 0 ? `${pluralize(guides.length, 'free guide')} on the work our products support.` : 'Practical guides will be published here.',
    href: routes.resources,
    cta: 'Browse guides',
  },
  {
    icon: 'lifebuoy' as const,
    title: 'Contact support',
    body: CAN_CONTACT ? 'Can’t find what you need? Send us the details and we’ll help.' : 'Support contact options are being set up.',
    href: routes.contactTopic('support'),
    cta: 'Get help',
  },
];
---

<BaseLayout
  title="Support"
  description={`Help, answers, and documentation for ${site.name} products — plus how to contact support.`}
  jsonLd={[breadcrumbLd([{ label: 'Home', href: '/' }, { label: 'Support', href: routes.support }], siteUrl)]}
>
  <PageHeader
    eyebrow="Support"
    title="Help and answers."
    description="Start with the documentation and common questions. If you’re still stuck, contact support."
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Support' }]}
  />

  <section class="container-site py-12 md:py-16" aria-label="Support options">
    <ul class="grid gap-4 md:grid-cols-3">
      {
        cards.map((card) => (
          <li class="card card-interactive group relative flex flex-col p-6">
            <span class="grid size-10 place-items-center rounded-xl border border-line-strong bg-surface-2 text-ink-2" aria-hidden="true">
              <Icon name={card.icon} size={19} />
            </span>
            <h2 class="mt-5 text-lg font-[620] text-ink">
              <a href={card.href} class="card-link">
                {card.title}
              </a>
            </h2>
            <p class="mt-2 text-[0.9375rem] text-ink-2">{card.body}</p>
            <span class="mt-auto flex items-center gap-1.5 pt-6 text-sm font-medium text-ink" aria-hidden="true">
              {card.cta} <Icon name="arrow-right" size={14} class="transition-transform group-hover:translate-x-0.5" />
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="border-t border-line" aria-labelledby="faq-title" id="faq">
    <div class="container-site py-14 md:py-20">
      <h2 id="faq-title" class="text-display-2 text-ink">Frequently asked questions</h2>
      {
        faqs.length > 0 ? (
          <div class="mt-12 space-y-14">
            {groups.map((group) => {
              const items = faqs.filter((faq) => faq.category === group.id);
              return (
                items.length > 0 && (
                  <div class="grid gap-6 lg:grid-cols-12">
                    <h3 class="eyebrow lg:col-span-3 lg:pt-6">{group.title}</h3>
                    <FaqList class="lg:col-span-9" items={items} />
                  </div>
                )
              );
            })}
          </div>
        ) : (
          <EmptyState icon="info" title="No questions here yet." class="mt-10" headingLevel="h3">
            <p>Answers to common questions will be added as products launch.</p>
          </EmptyState>
        )
      }
    </div>
  </section>

  <section class="border-t border-line" aria-labelledby="still-stuck-title">
    <div class="container-site flex flex-col items-start gap-6 py-14 md:flex-row md:items-center md:justify-between md:py-16">
      <div>
        <h2 id="still-stuck-title" class="text-display-3 text-ink">Still stuck?</h2>
        <p class="mt-2 text-ink-2">Tell us what you were trying to do and what happened instead.</p>
      </div>
      <Button href={routes.contactTopic('support')} arrow="right">Contact support</Button>
    </div>
  </section>
</BaseLayout>
