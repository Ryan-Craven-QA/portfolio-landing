# Cloudflare Pages / Workers static assets response headers.
# The Content-Security-Policy for scripts/styles is a <meta> tag generated by
# Astro on every page (see astro.config.ts). Directives that cannot be set in a
# meta tag live here.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# Fingerprinted build assets never change: cache them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/downloads/*
  Cache-Control: public, max-age=3600
  X-Robots-Tag: noindex

/search.json
  Cache-Control: public, max-age=600

# If you serve the site from a custom domain, uncomment these lines so the
# *.pages.dev copy is not indexed as a duplicate (see DEPLOYMENT.md):
# https://:project.pages.dev/*
#   X-Robots-Tag: noindex
