# Copy to .env for local overrides. Never commit real secrets — this site
# needs none: form/newsletter/analytics identifiers live in src/config/site.ts
# and are public by design.

# Canonical production URL (also set this in Cloudflare Pages → Settings → Environment variables).
SITE_URL=https://www.yourdomain.com

# Force noindex (useful for a staging deployment).
# SITE_NOINDEX=true

# Branch that Cloudflare Pages deploys to production (defaults to "main").
# Builds of any other branch are marked noindex.
# PRODUCTION_BRANCH=main
