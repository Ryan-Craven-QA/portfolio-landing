{
  "name": "portfolio-landing",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "dev:drafts": "astro dev --mode drafts",
    "build": "astro build && node scripts/verify-build.ts",
    "preview": "astro preview",
    "check": "astro check",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "build:fixtures": "astro build --config astro.fixtures.config.ts && node scripts/verify-build.ts --fixtures",
    "build:fixtures:portfolio": "astro build --config astro.fixtures-portfolio.config.ts && node scripts/verify-build.ts --fixtures-portfolio",
    "preview:fixtures": "astro preview --config astro.fixtures.config.ts --port 4322 --ignore-lock",
    "test:e2e": "npm run build:fixtures && npm run build:fixtures:portfolio && playwright test",
    "preflight": "node scripts/preflight.ts",
    "assets:icons": "node scripts/generate-icons.ts",
    "assets:og": "node scripts/generate-og.ts",
    "verify": "npm run check && npm run test:unit && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.3",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/mona-sans": "5.3.0",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.7",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  },
  "description": "Marketing and catalog website for an independent digital product studio. Static Astro site.",
  "engines": {
    "node": ">=22.23.4"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
